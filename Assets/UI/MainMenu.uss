/* Main actions panel */
.menu-panel {
    width: 86%;
    max-width: 420px;
    min-width: 0;
}

/* Main menu buttons */
.menu-button {
    width: 100%;
    max-width: 340px;
    min-width: 0;
}

/* Keep clear space for the bottom credits button */
#Content {
    padding-bottom: 72px;
}

/* Credits button at bottom of main menu */
.credits-btn {
    position: absolute;
    left: 50%;
    bottom: 12px;
    translate: -50% 0;
    width: 44%;
    max-width: 220px;
    min-width: 132px;
    height: 38px;
    margin-top: 0;
    font-size: 14px;
}

/* High scores panel container */
.highscores-panel {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    width: 92%;
    max-width: 920px;
    min-width: 0;
    height: 58%;
    min-height: 220px;
    max-height: 448px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 8px;
}

/* High scores body container */
.highscores-body {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

/* High scores footer container */
.highscores-footer {
    flex-shrink: 0;
    padding-top: 10px;
    align-items: center;
}

/* Scrollable list wrapper */
.scores-list {
    width: 100%;
    flex-grow: 1;
    min-height: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 1px;
    background-color: rgba(0, 0, 0, 0.22);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    overflow: hidden;
}

/* Scroll viewport clipping */
.scores-list .unity-scroll-view__viewport {
    overflow: hidden;
}

/* Scroll content padding */
.scores-list .unity-scroll-view__content-container {
    padding-bottom: 1px;
}

/* Vertical scrollbar track */
.scores-list .unity-scroll-view__vertical-scroller {
    width: 8px;
    min-width: 8px;
    background-color: rgba(255, 255, 255, 0.10);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* Vertical scrollbar thumb */
.scores-list .unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    width: 8px;
    min-width: 8px;
    background-color: rgba(0, 255, 224, 0.75);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* Scrollbar arrow buttons */
.scores-list .unity-scroll-view__vertical-scroller .unity-scroller__low-button,
.scores-list .unity-scroll-view__vertical-scroller .unity-scroller__high-button {
    display: none;
}

/* Hide secondary slider visuals to prevent double scrollbar render */
.scores-list .unity-scroll-view__vertical-scroller .unity-scroller__slider {
    display: none;
}

/* Back button spacing in high scores panel */
#BackButton {
    margin-top: 0;
    margin-bottom: 0;
}

/* High scores entry text */
.scores-list Label {
    color: rgb(240, 244, 255);
    font-size: 16px;
    -unity-font-style: bold;
    padding-top: 4px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    -unity-text-outline-width: 1px;
}
